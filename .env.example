# Copy to .env (git-ignored) for local settings; source it with `. ./.env`.
# scripts/check.sh reads it for the toolchain paths and ignores the server settings.

# Rust toolchain outside the default locations:
# export CARGO_HOME=/path/to/cargo
# export RUSTUP_HOME=/path/to/rustup
# export PATH="$CARGO_HOME/bin:$PATH"
# Build output outside the repository; scripts use ${CARGO_TARGET_DIR:-target}:
# export CARGO_TARGET_DIR=/path/to/target

# Server settings (docs/PRODUCTION.md):
# export MERIDIAN_CONFIG=config/production.json   # default config/app.json does not capture
# export MERIDIAN_ADMIN_TOKEN_FILE=/path/to/token # at least 24 characters; or MERIDIAN_ADMIN_TOKEN
# export MERIDIAN_CAPTURE_QUOTA_BYTES=2147483648  # rolling IQ quota, default 2 GiB
# export MERIDIAN_DIRECTORY_OFFLINE=1             # no public receiver directory refresh
# export MERIDIAN_KIWI_TRANSPORT=native           # or kiwiclient; behind an HTTP proxy only kiwiclient works
# export PORT=3000                                # listen on 0.0.0.0:PORT instead of the configured address
# MERIDIAN_SEED_RECORDING=1 (container only) copies the archived 2020 recording into data/ for tests.

# docker compose (compose.yaml with Caddy) reads MERIDIAN_DOMAIN from this file:
# MERIDIAN_DOMAIN=example.org
